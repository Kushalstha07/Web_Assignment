# Docker Compose environment. Copy to .env and replace every placeholder.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Required for password-recovery email delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
MAIL_FROM=Edu Global <no-reply@example.com>

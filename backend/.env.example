# Backend HTTP server
PORT=4000

# Local development database. Use a separate, secret value in production.
MONGODB_URL=mongodb://localhost:27017/consultancy-db

# Generate a long random value for every deployed environment.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long

# JWT lifetime accepted by jsonwebtoken (for example: 15m, 12h, or 30d).
JWT_EXPIRES_IN=30d

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000

# Per-process login attempt limit. Use a shared store when horizontally scaling.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Password recovery links and abuse protection.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_TTL_MS=3600000
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RATE_LIMIT_MAX=5

# SMTP credentials used to deliver password-reset messages.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
MAIL_FROM=Edu Global <no-reply@example.com>
